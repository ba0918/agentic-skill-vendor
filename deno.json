{
  "fmt": {
    // Markdown keeps the sister repositories' hand-wrapped style; fmt governs
    // TypeScript only. fixtures/ is excluded whole: its JSON is the tool's own
    // canonical form (recursively sorted keys, byte-compared by verify), and
    // letting fmt restyle it would make the fixture fail the very check it
    // exists to exercise.
    "exclude": ["**/*.md", "fixtures/"]
  },
  "tasks": {
    // The tool itself needs read and write and nothing more, so the suite that
    // drives it is granted exactly that.
    "test": "deno test --allow-read --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  // Pinned to exact versions rather than ranges so that the version a run
  // resolves is stated here and not only in deno.lock. @std/assert and @std/fs
  // are reached only by the test suite; @std/yaml is reached by the tool
  // itself. None of them asks for a permission the tool does not already have:
  // the tool still runs on --allow-read and --allow-write alone.
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "ignore": "npm:ignore@7.0.6"
  }
}
