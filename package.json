{
  "name": "@ba0918-dev/agentic-skill-vendor",
  "version": "0.1.0",
  "description": "Vendors shared reference documents into agent skill directories and locks what each skill depends on.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentic-skill-vendor": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ba0918/agentic-skill-vendor.git"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "build": "bun build src/cli.ts --target node --packages external --outdir dist",
    "prepack": "bun run build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ignore": "7.0.6",
    "js-yaml": "5.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "lefthook": "2.1.10",
    "typescript": "7.0.2"
  }
}
