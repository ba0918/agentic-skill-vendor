{
  "name": "@ba0918/skill-shared-reference-vendor",
  "version": "0.1.0",
  "description": "Vendors shared reference documents into agent skill directories and locks what each skill depends on.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skill-vendor": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ba0918/agentic-skill-shared-reference-vendoring.git"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "build": "bun build src/cli.ts --target node --outdir dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "ignore": "7.0.6",
    "js-yaml": "5.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14"
  }
}
